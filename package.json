{
  "name": "rtf-preview-hardened",
  "displayName": "RTF Preview (Hardened Fork)",
  "description": "Hardened fork of RTF Live Preview 0.5.2: a read-only RTF viewer for SAS ODS RTF output that is safe to open on files from outside.",
  "version": "1.0.0",
  "publisher": "dcri-biostats",
  "repository": {
    "type": "git",
    "url": "https://github.com/teebs4140/rtf-preview-hardened.git"
  },
  "homepage": "https://github.com/teebs4140/rtf-preview-hardened",
  "bugs": {
    "url": "https://github.com/teebs4140/rtf-preview-hardened/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "rtf",
    "preview",
    "rich text",
    "SAS",
    "ODS"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "rtfPreviewHardened.viewer",
        "displayName": "RTF Preview (Hardened)",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.rtf"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "rtfPreviewHardened.openToSide",
        "title": "RTF: Open Preview to the Side",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .rtf && activeEditor == workbench.editors.files.textFileEditor",
          "command": "rtfPreviewHardened.openToSide",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == .rtf",
          "command": "rtfPreviewHardened.openToSide",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "rtfPreviewHardened.openToSide",
          "when": "resourceExtname == .rtf"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test test/unit/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.0.0"
  }
}
